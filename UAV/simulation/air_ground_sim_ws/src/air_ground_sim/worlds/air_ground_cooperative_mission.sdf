<?xml version="1.0"?>
<sdf version="1.9">
  <world name="air_ground_cooperative">
    <physics name="1ms" type="ignore">
      <!-- ArduPilot's 400 Hz control loop requires IMU samples at >= 1.8x the
           loop rate. Keep the physics/JSON IMU stream at 1 kHz; rendering is
           optimized independently so the real flight-controller invariant is
           never weakened for the demo. -->
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <scene>
      <ambient>0.72 0.75 0.78 1</ambient>
      <background>0.44 0.62 0.78 1</background>
      <sky/>
      <shadows>true</shadows>
    </scene>
    <spherical_coordinates>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>
    <light type="directional" name="sun">
      <pose>0 0 24 0 0 0</pose><cast_shadows>true</cast_shadows>
      <diffuse>0.95 0.94 0.90 1</diffuse><specular>0.20 0.20 0.20 1</specular>
      <direction>-0.45 0.20 -0.86</direction>
    </light>

    <model name="mission_ground">
      <static>true</static>
      <link name="link">
        <pose>0 0 -0.05 0 0 0</pose>
        <collision name="collision"><geometry><box><size>30 22 0.10</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>30 22 0.10</size></box></geometry>
          <material><ambient>0.31 0.36 0.32 1</ambient><diffuse>0.38 0.44 0.39 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Mapped boundary. -->
    <model name="west_wall"><static>true</static><pose>-14.75 0 0.60 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.5 22 1.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.5 22 1.2</size></box></geometry><material><ambient>0.56 0.58 0.62 1</ambient><diffuse>0.68 0.70 0.74 1</diffuse></material></visual></link></model>
    <model name="east_wall"><static>true</static><pose>14.75 0 0.60 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.5 22 1.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.5 22 1.2</size></box></geometry><material><ambient>0.56 0.58 0.62 1</ambient><diffuse>0.68 0.70 0.74 1</diffuse></material></visual></link></model>
    <model name="north_wall"><static>true</static><pose>0 10.75 0.60 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>30 0.5 1.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>30 0.5 1.2</size></box></geometry><material><ambient>0.56 0.58 0.62 1</ambient><diffuse>0.68 0.70 0.74 1</diffuse></material></visual></link></model>
    <model name="south_wall"><static>true</static><pose>0 -10.75 0.60 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>30 0.5 1.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>30 0.5 1.2</size></box></geometry><material><ambient>0.56 0.58 0.62 1</ambient><diffuse>0.68 0.70 0.74 1</diffuse></material></visual></link></model>

    <!-- Ground obstacles mirrored in cooperative_map.pgm. -->
    <model name="warehouse_a"><static>true</static><pose>-5.5 -3.8 1.1 0 0 0.15</pose><link name="link"><collision name="collision"><geometry><box><size>2.6 2.2 2.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.6 2.2 2.2</size></box></geometry><material><ambient>0.55 0.25 0.10 1</ambient><diffuse>0.70 0.33 0.12 1</diffuse></material></visual></link></model>
    <model name="warehouse_b"><static>true</static><pose>-2.0 2.0 1.0 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>2.0 4.8 2.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.0 4.8 2.0</size></box></geometry><material><ambient>0.22 0.32 0.43 1</ambient><diffuse>0.28 0.43 0.58 1</diffuse></material></visual></link></model>
    <model name="warehouse_c"><static>true</static><pose>3.1 0.2 0.9 0 0 -0.10</pose><link name="link"><collision name="collision"><geometry><box><size>2.0 3.0 1.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.0 3.0 1.8</size></box></geometry><material><ambient>0.25 0.42 0.28 1</ambient><diffuse>0.31 0.54 0.36 1</diffuse></material></visual></link></model>
    <model name="warehouse_d"><static>true</static><pose>7.6 3.7 0.8 0 0 0.25</pose><link name="link"><collision name="collision"><geometry><box><size>2.5 1.8 1.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.5 1.8 1.6</size></box></geometry><material><ambient>0.45 0.42 0.18 1</ambient><diffuse>0.60 0.55 0.22 1</diffuse></material></visual></link></model>
    <model name="warehouse_e"><static>true</static><pose>8.0 -1.8 0.9 0 0 -0.20</pose><link name="link"><collision name="collision"><geometry><box><size>2.2 3.2 1.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.2 3.2 1.8</size></box></geometry><material><ambient>0.38 0.22 0.30 1</ambient><diffuse>0.52 0.30 0.42 1</diffuse></material></visual></link></model>

    <!-- Unmapped pallet: Nav2 must mark it from live lidar instead of relying
         on the static occupancy map. -->
    <model name="unmapped_pallet"><static>true</static><pose>1.0 -3.8 0.55 0 0 0.35</pose><link name="link"><collision name="collision"><geometry><box><size>1.2 0.9 1.1</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.2 0.9 1.1</size></box></geometry><material><ambient>0.70 0.08 0.06 1</ambient><diffuse>0.90 0.12 0.08 1</diffuse></material></visual></link></model>

    <!-- Aerial gate: columns affect both vehicles; the high crossbar is only
         visible to the UAV 3D lidar / stereo depth at flight altitude. -->
    <model name="aerial_gate"><static>true</static><pose>-6.5 0 0 0 0 0</pose><link name="link">
      <collision name="left_column_collision"><pose>0 1.65 2.0 0 0 0</pose><geometry><box><size>0.45 0.45 4.0</size></box></geometry></collision>
      <collision name="right_column_collision"><pose>0 -1.65 2.0 0 0 0</pose><geometry><box><size>0.45 0.45 4.0</size></box></geometry></collision>
      <collision name="crossbar_collision"><pose>0 0 3.55 0 0 0</pose><geometry><box><size>0.55 3.75 0.45</size></box></geometry></collision>
      <visual name="left_column"><pose>0 1.65 2.0 0 0 0</pose><geometry><box><size>0.45 0.45 4.0</size></box></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.22 0.23 0.26 1</diffuse></material></visual>
      <visual name="right_column"><pose>0 -1.65 2.0 0 0 0</pose><geometry><box><size>0.45 0.45 4.0</size></box></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.22 0.23 0.26 1</diffuse></material></visual>
      <visual name="crossbar"><pose>0 0 3.55 0 0 0</pose><geometry><box><size>0.55 3.75 0.45</size></box></geometry><material><ambient>0.12 0.12 0.14 1</ambient><diffuse>0.22 0.23 0.26 1</diffuse></material></visual>
      <visual name="height_label"><pose>-0.31 0 3.05 0 1.57079632679 0</pose><geometry><box><size>0.02 1.8 0.45</size></box></geometry><material><ambient>0.90 0.70 0.08 1</ambient><diffuse>1.0 0.82 0.10 1</diffuse></material></visual>
    </link></model>

    <!-- Suspended obstacle and low ceiling exercise vertical avoidance. -->
    <model name="suspended_panel"><static>true</static><pose>0.6 4.0 3.0 0 0 0.35</pose><link name="link"><collision name="collision"><geometry><box><size>0.35 4.2 2.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.35 4.2 2.8</size></box></geometry><material><ambient>0.40 0.08 0.08 1</ambient><diffuse>0.62 0.12 0.10 1</diffuse></material></visual></link></model>
    <model name="low_ceiling"><static>true</static><pose>3.0 -3.5 2.55 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>4.5 2.2 0.30</size></box></geometry></collision><visual name="visual"><geometry><box><size>4.5 2.2 0.30</size></box></geometry><material><ambient>0.58 0.45 0.08 1</ambient><diffuse>0.78 0.61 0.10 1</diffuse></material></visual></link></model>

    <!-- Visual-only airspace volumes correspond exactly to software rules in
         cooperative_mission.yaml. They make the invisible operational limits
         understandable in Gazebo without faking physical collisions. -->
    <model name="no_fly_tower_volume"><static>true</static><pose>-3.7 -1.2 4.0 0 0 0</pose><link name="link"><visual name="volume"><transparency>0.74</transparency><geometry><cylinder><radius>1.55</radius><length>8.0</length></cylinder></geometry><material><ambient>0.65 0.02 0.02 0.28</ambient><diffuse>0.95 0.03 0.03 0.28</diffuse></material></visual></link></model>
    <model name="height_limit_volume"><static>true</static><pose>3.0 -3.5 1.15 0 0 0</pose><link name="link"><visual name="volume"><transparency>0.80</transparency><geometry><box><size>4.5 2.2 2.3</size></box></geometry><material><ambient>0.80 0.58 0.02 0.20</ambient><diffuse>1.0 0.74 0.03 0.20</diffuse></material></visual></link></model>
    <model name="no_fly_destination_volume"><static>true</static><pose>8.7 6.9 3.5 0 0 0</pose><link name="link"><visual name="volume"><transparency>0.78</transparency><geometry><cylinder><radius>1.35</radius><length>7.0</length></cylinder></geometry><material><ambient>0.65 0.02 0.02 0.24</ambient><diffuse>0.95 0.03 0.03 0.24</diffuse></material></visual></link></model>

    <!-- UAV begins roughly eleven metres from the parked Hunter. The latch is
         released by the first mission state before any vehicle moves. -->
    <include>
      <uri>model://uav_camera_rig</uri><name>uav</name>
      <pose>0 0 0.20 0 0 1.57079632679</pose>
    </include>
    <include>
      <uri>model://hunter_ackermann</uri><name>ground_vehicle</name>
      <pose>-9 -6 0 0 0 0</pose>
    </include>
  </world>
</sdf>
