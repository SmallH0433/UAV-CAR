      "owner_timeout_s": 0.5
    }
  },
  "guided_execution": {
    "target_mode": "GUIDED",
    "fallback_mode": "LOITER",
    "previous_mode_allowlist": ["LOITER", "BRAKE", "POSHOLD", "ALT_HOLD"],
    "mavros_service_ack_timeout_s": 1.0,
