<?xml version="1.0"?>
<sdf version="1.9">
  <model name="ground_vehicle">
    <pose>0 0 0 0 0 0</pose>

    <link name="base_link">
      <!-- Keep the body collision 40 mm above the ground so the wheels, not
           the chassis belly, carry the vehicle and generate traction. -->
      <pose>0 0 0.30 0 0 0</pose>
      <inertial>
        <mass>18.0</mass>
        <inertia>
          <ixx>0.65</ixx><iyy>1.10</iyy><izz>1.35</izz>
        </inertia>
      </inertial>
      <collision name="body_collision">
        <geometry><box><size>0.82 0.54 0.18</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <geometry><box><size>0.82 0.54 0.18</size></box></geometry>
        <material>
          <ambient>0.05 0.18 0.28 1</ambient>
          <diffuse>0.08 0.32 0.48 1</diffuse>
        </material>
      </visual>
      <visual name="landing_pad">
        <pose>0 0 0.105 0 0 0</pose>
        <geometry><box><size>0.40 0.40 0.018</size></box></geometry>
        <material>
          <ambient>0.75 0.75 0.75 1</ambient>
          <diffuse>0.85 0.85 0.85 1</diffuse>
        </material>
      </visual>
      <!-- Physical target shown in the supplied reference photo:
           tag36h11 ID 0, 200 mm black edge plus a 25 mm white quiet
           border on every side, for a 250 x 250 mm printed board. -->
      <visual name="apriltag_id0">
        <pose>0 0 0.115 0 0 0</pose>
        <geometry><plane><normal>0 0 1</normal><size>0.25 0.25</size></plane></geometry>
        <material>
          <ambient>1 1 1 1</ambient>
          <diffuse>1 1 1 1</diffuse>
          <specular>0 0 0 1</specular>
          <pbr>
            <metal>
              <albedo_map>model://ground_vehicle/materials/textures/tag36h11_id0.png</albedo_map>
              <metalness>0.0</metalness>
              <roughness>1.0</roughness>
            </metal>
          </pbr>
        </material>
      </visual>
    </link>

    <link name="left_front_wheel">
      <pose>0.30 0.33 0.17 1.57079632679 0 0</pose>
      <inertial><mass>1.0</mass><inertia><ixx>0.015</ixx><iyy>0.015</iyy><izz>0.025</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.17</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.17</radius><length>0.08</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse></material></visual>
    </link>
    <link name="left_rear_wheel">
      <pose>-0.30 0.33 0.17 1.57079632679 0 0</pose>
      <inertial><mass>1.0</mass><inertia><ixx>0.015</ixx><iyy>0.015</iyy><izz>0.025</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.17</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.17</radius><length>0.08</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse></material></visual>
    </link>
    <link name="right_front_wheel">
      <pose>0.30 -0.33 0.17 1.57079632679 0 0</pose>
      <inertial><mass>1.0</mass><inertia><ixx>0.015</ixx><iyy>0.015</iyy><izz>0.025</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.17</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.17</radius><length>0.08</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse></material></visual>
    </link>
    <link name="right_rear_wheel">
      <pose>-0.30 -0.33 0.17 1.57079632679 0 0</pose>
      <inertial><mass>1.0</mass><inertia><ixx>0.015</ixx><iyy>0.015</iyy><izz>0.025</izz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.17</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.17</radius><length>0.08</length></cylinder></geometry><material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.06 0.06 0.06 1</diffuse></material></visual>
    </link>

    <!-- Joint axes are expressed in each rotated wheel frame.  Local Z is the
         axle direction after the 90-degree wheel-link roll. -->
    <joint name="left_front_joint" type="revolute">
      <parent>base_link</parent><child>left_front_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.0e16</lower><upper>1.0e16</upper></limit></axis>
    </joint>
    <joint name="left_rear_joint" type="revolute">
      <parent>base_link</parent><child>left_rear_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.0e16</lower><upper>1.0e16</upper></limit></axis>
    </joint>
    <joint name="right_front_joint" type="revolute">
      <parent>base_link</parent><child>right_front_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.0e16</lower><upper>1.0e16</upper></limit></axis>
    </joint>
    <joint name="right_rear_joint" type="revolute">
      <parent>base_link</parent><child>right_rear_wheel</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-1.0e16</lower><upper>1.0e16</upper></limit></axis>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_front_joint</left_joint>
      <left_joint>left_rear_joint</left_joint>
      <right_joint>right_front_joint</right_joint>
      <right_joint>right_rear_joint</right_joint>
      <wheel_separation>0.66</wheel_separation>
      <wheel_radius>0.17</wheel_radius>
      <topic>/model/ground_vehicle/cmd_vel</topic>
      <odom_topic>/model/ground_vehicle/odometry</odom_topic>
      <tf_topic>/model/ground_vehicle/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>ugv_base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>1.5</max_angular_acceleration>
    </plugin>
  </model>
</sdf>
