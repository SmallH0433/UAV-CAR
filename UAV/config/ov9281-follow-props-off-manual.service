[Unit]
Description=OV9281 props-removed GUIDED follow motor-mix test (boot enabled)
Requires=ov9281-vision.service
After=ov9281-vision.service
Conflicts=ov9281-follow-observer.service apriltag-follow-monitor.service ov9281-follow-readiness-tone.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/PI/venvs/landing/bin/python /home/PI/ov9281_debug/ov9281_follow_props_off_test.py --config /home/PI/ov9281_debug/ov9281_follow_props_off_control_20260814.json
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=5

[Install]
WantedBy=default.target
