[Unit]
Description=MAVROS sole serial owner for OV9281 follow and precision landing
Conflicts=ov9281-follow-props-off-manual.service
After=ov9281-vision.service

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
ExecStartPre=-/usr/bin/podman rm -f ov9281-mavros
ExecStart=/usr/bin/podman run --rm --name ov9281-mavros --network host --ipc=host --device /dev/ttyAMA0 --group-add keep-groups -v /home/pi/air_ground_landing/config:/config:ro localhost/air-ground-landing-ros2:humble /bin/bash -lc 'source /opt/ros/humble/setup.bash && exec ros2 run mavros mavros_node --ros-args -r __ns:=/mavros -p fcu_url:=/dev/ttyAMA0:57600 -p tgt_system:=1 -p tgt_component:=1 -p fcu_protocol:=v2.0 --params-file /opt/ros/humble/share/mavros/launch/apm_pluginlists.yaml --params-file /opt/ros/humble/share/mavros/launch/apm_config.yaml --params-file /config/mavros_precland_override.yaml'
ExecStop=/usr/bin/podman stop -t 8 ov9281-mavros
Restart=on-failure
RestartSec=3
KillSignal=SIGINT
TimeoutStopSec=12

[Install]
WantedBy=default.target
