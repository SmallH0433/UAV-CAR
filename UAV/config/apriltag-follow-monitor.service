[Unit]
Description=UAV AprilTag receive-only readiness monitor
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/PI/uav/bin
ExecStart=/home/PI/venvs/landing/bin/python /home/PI/uav/bin/follow_readiness_monitor.py --config /home/PI/uav/config/apriltag_follow_pi_monitor_20260807.json
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
