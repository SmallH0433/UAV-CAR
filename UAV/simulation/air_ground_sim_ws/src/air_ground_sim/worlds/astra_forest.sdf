<?xml version="1.0"?>
<!--
  Gazebo Harmonic port of the AstraDroneOpen forest.world layout.
  Original project: https://github.com/yidrone/AstraDroneOpen (MIT).
  The original Gazebo Classic mesh models are represented here with native,
  collidable SDF primitives so this world stays compatible with Harmonic.
-->
<sdf version="1.9">
  <world name="air_ground">
    <physics name="1ms" type="ignore">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"><render_engine>ogre2</render_engine></plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <scene>
      <ambient>0.72 0.76 0.72 1</ambient>
      <background>0.48 0.67 0.83 1</background>
      <sky/>
    </scene>
    <spherical_coordinates>
      <latitude_deg>22.1350000</latitude_deg>
      <longitude_deg>113.5447296</longitude_deg>
      <elevation>10</elevation>
      <heading_deg>0</heading_deg>
      <surface_model>EARTH_WGS84</surface_model>
    </spherical_coordinates>
    <light type="directional" name="sun">
      <pose>0 0 30 0 0 0</pose><cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.85 1</diffuse><specular>0.2 0.2 0.2 1</specular>
      <direction>-0.45 0.25 -0.86</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>110 110</size></plane></geometry></collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>110 110</size></plane></geometry>
          <material><ambient>0.26 0.40 0.20 1</ambient><diffuse>0.32 0.48 0.24 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Tree names and XY positions match AstraDroneOpen forest.world. -->
    <include><uri>model://astra_oak_tree</uri><name>Oak_tree</name><pose>-4.65578 -5.01823 0 0 0 0</pose></include>
    <include><uri>model://astra_oak_tree</uri><name>Oak_tree_0</name><pose>-10.0443 10.2228 0 0 0 0</pose></include>
    <include><uri>model://astra_oak_tree</uri><name>Oak_tree_1</name><pose>12.8892 5.49102 0 0 0 0</pose></include>
    <include><uri>model://astra_oak_tree</uri><name>Oak_tree_2</name><pose>-23.7091 -15.4511 0 0 0 0</pose></include>
    <include><uri>model://astra_oak_tree</uri><name>Oak_tree_3</name><pose>10.3696 -24.5563 0 0 0 0</pose></include>
    <include><uri>model://astra_oak_tree</uri><name>Oak_tree_4</name><pose>6.92386 25.9759 0 0 0 0</pose></include>
    <include><uri>model://astra_oak_tree</uri><name>Oak_tree_5</name><pose>28.518 -12.988 0 0 0 0</pose></include>
    <include><uri>model://astra_oak_tree</uri><name>Oak_tree_6</name><pose>-29.7502 13.8613 0 0 0 0</pose></include>
    <include><uri>model://astra_oak_tree</uri><name>Oak_tree_7</name><pose>-9.45771 -23.033 0 0 0 0</pose></include>
    <include><uri>model://astra_oak_tree</uri><name>Oak_tree_8</name><pose>23.787 19.6562 0 0 0 0</pose></include>
    <include><uri>model://astra_oak_tree</uri><name>Oak_tree_9</name><pose>33.249 5.20517 0 0 0 0</pose></include>
    <include><uri>model://astra_oak_tree</uri><name>Oak_tree_10</name><pose>-2.18436 -37.665 0 0 0 0</pose></include>
    <include><uri>model://astra_oak_tree</uri><name>Oak_tree_11</name><pose>26.8344 -34.9455 0 0 0 0</pose></include>
    <include><uri>model://astra_oak_tree</uri><name>juniper_Tree</name><pose>-24.8579 -24.746 0 0 0 0</pose></include>

    <include><uri>model://astra_pine_tree</uri><name>Pine_Tree</name><pose>9.97516 9.16049 0 0 0 0</pose></include>
    <include><uri>model://astra_pine_tree</uri><name>Pine_Tree_0</name><pose>-26.2144 -1.2501 0 0 0 0</pose></include>
    <include><uri>model://astra_pine_tree</uri><name>Pine_Tree_1</name><pose>-19.9547 9.71862 0 0 0 0</pose></include>
    <include><uri>model://astra_pine_tree</uri><name>Pine_Tree_2</name><pose>4.0396 14.7348 0 0 0 0</pose></include>
    <include><uri>model://astra_pine_tree</uri><name>Pine_Tree_3</name><pose>18.3644 -7.22322 0 0 0 0</pose></include>
    <include><uri>model://astra_pine_tree</uri><name>Pine_Tree_4</name><pose>-12.9054 -12.7386 0 0 0 0</pose></include>
    <include><uri>model://astra_pine_tree</uri><name>Pine_Tree_5</name><pose>4.71231 -14.3737 0 0 0 0</pose></include>
    <include><uri>model://astra_pine_tree</uri><name>Pine_Tree_6</name><pose>14.8743 -14.302 0 0 0 0</pose></include>
    <include><uri>model://astra_pine_tree</uri><name>Pine_Tree_7</name><pose>22.0901 10.9764 0 0 0 0</pose></include>

    <model name="House_3">
      <pose>-35 -33.4664 0 0 0 0</pose><static>true</static>
      <link name="building">
        <collision name="body_collision"><pose>0 0 3 0 0 0</pose><geometry><box><size>9 8 6</size></box></geometry></collision>
        <visual name="body"><pose>0 0 3 0 0 0</pose><geometry><box><size>9 8 6</size></box></geometry><material><ambient>0.58 0.42 0.28 1</ambient><diffuse>0.70 0.54 0.36 1</diffuse></material></visual>
        <visual name="roof"><pose>0 0 6.5 0 0 0</pose><geometry><box><size>10 9 1</size></box></geometry><material><ambient>0.28 0.12 0.10 1</ambient><diffuse>0.43 0.18 0.14 1</diffuse></material></visual>
      </link>
    </model>
    <model name="House_1">
      <pose>-39.4031 -5.493 0 0 0 0</pose><static>true</static>
      <link name="building">
        <collision name="collision"><pose>0 0 2.5 0 0 0</pose><geometry><box><size>8 7 5</size></box></geometry></collision>
        <visual name="visual"><pose>0 0 2.5 0 0 0</pose><geometry><box><size>8 7 5</size></box></geometry><material><ambient>0.62 0.58 0.48 1</ambient><diffuse>0.74 0.69 0.56 1</diffuse></material></visual>
      </link>
    </model>
    <model name="House_1_0">
      <pose>-39 30 0 0 0 0</pose><static>true</static>
      <link name="building">
        <collision name="collision"><pose>0 0 2.5 0 0 0</pose><geometry><box><size>8 7 5</size></box></geometry></collision>
        <visual name="visual"><pose>0 0 2.5 0 0 0</pose><geometry><box><size>8 7 5</size></box></geometry><material><ambient>0.52 0.55 0.60 1</ambient><diffuse>0.62 0.66 0.72 1</diffuse></material></visual>
      </link>
    </model>

    <model name="radio_tower"><pose>-17.4209 22.29 0 0 0 0</pose><static>true</static><link name="tower">
      <collision name="mast_collision"><pose>0 0 8 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>16</length></cylinder></geometry></collision>
      <visual name="mast"><pose>0 0 8 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>16</length></cylinder></geometry><material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material></visual>
      <visual name="bar"><pose>0 0 13 0 0 0</pose><geometry><box><size>4 0.25 0.25</size></box></geometry><material><diffuse>0.8 0.2 0.15 1</diffuse></material></visual>
    </link></model>
    <model name="radio_tower_0"><pose>24.4614 39.3288 0 0 0 0</pose><static>true</static><link name="tower">
      <collision name="mast_collision"><pose>0 0 8 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>16</length></cylinder></geometry></collision>
      <visual name="mast"><pose>0 0 8 0 0 0</pose><geometry><cylinder><radius>0.35</radius><length>16</length></cylinder></geometry><material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.7 0.7 0.72 1</diffuse></material></visual>
      <visual name="bar"><pose>0 0 13 0 0 0</pose><geometry><box><size>4 0.25 0.25</size></box></geometry><material><diffuse>0.8 0.2 0.15 1</diffuse></material></visual>
    </link></model>

    <model name="water_tower"><pose>-18.3559 -29.7161 0 0 0 0</pose><static>true</static><link name="tower">
      <collision name="column_collision"><pose>0 0 5 0 0 0</pose><geometry><cylinder><radius>0.65</radius><length>10</length></cylinder></geometry></collision>
      <collision name="tank_collision"><pose>0 0 11 0 0 0</pose><geometry><cylinder><radius>2.3</radius><length>3</length></cylinder></geometry></collision>
      <visual name="column"><pose>0 0 5 0 0 0</pose><geometry><cylinder><radius>0.65</radius><length>10</length></cylinder></geometry><material><diffuse>0.45 0.45 0.47 1</diffuse></material></visual>
      <visual name="tank"><pose>0 0 11 0 0 0</pose><geometry><cylinder><radius>2.3</radius><length>3</length></cylinder></geometry><material><diffuse>0.35 0.50 0.62 1</diffuse></material></visual>
    </link></model>

    <model name="ambulance"><pose>-5.62287 31.7253 0 0 0 0</pose><static>true</static><link name="body">
      <collision name="collision"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>5.2 2.2 2.5</size></box></geometry></collision>
      <visual name="visual"><pose>0 0 1.25 0 0 0</pose><geometry><box><size>5.2 2.2 2.5</size></box></geometry><material><diffuse>0.92 0.92 0.90 1</diffuse></material></visual>
      <visual name="stripe"><pose>0 -1.11 1.2 0 0 0</pose><geometry><box><size>4.8 0.03 0.35</size></box></geometry><material><diffuse>0.8 0.08 0.06 1</diffuse></material></visual>
    </link></model>
    <model name="euro_pallet"><pose>-9.31039 6.75911 0 0 0 0</pose><static>true</static><link name="pallet">
      <collision name="collision"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>1.2 0.8 0.24</size></box></geometry></collision>
      <visual name="visual"><pose>0 0 0.12 0 0 0</pose><geometry><box><size>1.2 0.8 0.24</size></box></geometry><material><diffuse>0.52 0.30 0.12 1</diffuse></material></visual>
    </link></model>
    <model name="coral01"><pose>-3.82746 8.48135 0 0 0 0</pose><static>true</static><link name="rock">
      <collision name="collision"><pose>0 0 0.7 0 0 0</pose><geometry><sphere><radius>0.7</radius></sphere></geometry></collision>
      <visual name="visual"><pose>0 0 0.7 0 0 0</pose><geometry><sphere><radius>0.7</radius></sphere></geometry><material><diffuse>0.55 0.46 0.37 1</diffuse></material></visual>
    </link></model>

    <!-- Current UAV, virtual IMX296 camera and UGV interfaces remain unchanged. -->
    <include><uri>model://uav_camera_rig</uri><name>uav</name><pose>0 0 0.20 0 0 1.57079632679</pose></include>
    <include><uri>model://ground_vehicle</uri><name>ground_vehicle</name><pose>2.0 0 0 0 0 3.14159265359</pose></include>
  </world>
</sdf>
