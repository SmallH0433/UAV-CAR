<?xml version="1.0"?>
<sdf version="1.9">
  <!-- R680 4WD 滑移转向小车（WHEELTEC 底盘）
       几何/惯性按 car_description/urdf/CAR_description.urdf 换算：
       整车 465x385x218 mm，轮半径 0.076 m，轮距 0.32 m，轴距 0.31 m，底盘 16 kg。
       世界文件中以 <name>ground_vehicle</name> 包含，故 gz topic 前缀为
       /model/ground_vehicle/... -->
  <model name="r680_4wd">
    <self_collide>false</self_collide>

    <link name="base_link">
      <!-- base_link 与轮轴同高（轮半径 0.076） -->
      <pose>0 0 0.076 0 0 0</pose>
      <inertial>
        <mass>16.0</mass>
        <pose>0 0 0.070 0 0 0</pose>
        <inertia>
          <ixx>0.104700</ixx><iyy>0.144033</iyy><izz>0.233733</izz>
        </inertia>
      </inertial>
      <!-- 简化碰撞体：底部距地约 81 mm，不遮挡车轮 -->
      <collision name="body_collision">
        <pose>0 0 0.070 0 0 0</pose>
        <geometry><box><size>0.320 0.270 0.130</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <pose>0 0 0.070 0 0 0</pose>
        <geometry><box><size>0.320 0.270 0.130</size></box></geometry>
        <material>
          <ambient>0.10 0.11 0.12 1</ambient>
          <diffuse>0.20 0.22 0.24 1</diffuse>
        </material>
      </visual>
      <!-- 上层安装铝板 -->
      <visual name="deck_visual">
        <pose>0 0 0.136 0 0 0</pose>
        <geometry><box><size>0.340 0.285 0.012</size></box></geometry>
        <material>
          <ambient>0.60 0.62 0.65 1</ambient>
          <diffuse>0.72 0.75 0.78 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 车轮 link 滚转 +90 度，关节局部 Z 轴即轮轴（指向车体 -Y 右侧）；
         取关节轴 -Z（即车体 +Y），使正关节速度驱动车辆向 +X 前进。
         实测：轴向为 +Z 时 DiffDrive 正指令使车辆后退。 -->
    <!-- 滑移转向需要低横向摩擦：fdir1 沿轮子滚动方向（link 局部 X），
         mu 为滚动/牵引摩擦，mu2 为横向滑动摩擦。mu2 过大（如 1.0）会
         使四轮侧滑被锁死，车辆无法原地转向（实测 yaw≈0）。 -->
    <link name="front_left_wheel_link">
      <pose>0.155 0.160 0.076 1.57079632679 0 0</pose>
      <inertial><mass>1.2</mass><inertia><ixx>0.0021553</ixx><iyy>0.0021553</iyy><izz>0.0034656</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.076</radius><length>0.065</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.1</mu2><fdir1>1 0 0</fdir1></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.076</radius><length>0.065</length></cylinder></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <link name="front_right_wheel_link">
      <pose>0.155 -0.160 0.076 1.57079632679 0 0</pose>
      <inertial><mass>1.2</mass><inertia><ixx>0.0021553</ixx><iyy>0.0021553</iyy><izz>0.0034656</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.076</radius><length>0.065</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.1</mu2><fdir1>1 0 0</fdir1></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.076</radius><length>0.065</length></cylinder></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <link name="rear_left_wheel_link">
      <pose>-0.155 0.160 0.076 1.57079632679 0 0</pose>
      <inertial><mass>1.2</mass><inertia><ixx>0.0021553</ixx><iyy>0.0021553</iyy><izz>0.0034656</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.076</radius><length>0.065</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.1</mu2><fdir1>1 0 0</fdir1></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.076</radius><length>0.065</length></cylinder></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <link name="rear_right_wheel_link">
      <pose>-0.155 -0.160 0.076 1.57079632679 0 0</pose>
      <inertial><mass>1.2</mass><inertia><ixx>0.0021553</ixx><iyy>0.0021553</iyy><izz>0.0034656</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.076</radius><length>0.065</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>0.1</mu2><fdir1>1 0 0</fdir1></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.076</radius><length>0.065</length></cylinder></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>

    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_left_wheel_link</child>
      <axis><xyz>0 0 -1</xyz><limit><lower>-1.0e16</lower><upper>1.0e16</upper></limit></axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_right_wheel_link</child>
      <axis><xyz>0 0 -1</xyz><limit><lower>-1.0e16</lower><upper>1.0e16</upper></limit></axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel_link</child>
      <axis><xyz>0 0 -1</xyz><limit><lower>-1.0e16</lower><upper>1.0e16</upper></limit></axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel_link</child>
      <axis><xyz>0 0 -1</xyz><limit><lower>-1.0e16</lower><upper>1.0e16</upper></limit></axis>
    </joint>

    <!-- 顶部激光雷达：URDF laser_frame 安装位 (0.100, 0, 0.162) -->
    <link name="laser_frame">
      <pose relative_to="base_link">0.100 0 0.162 0 0 0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.220</mass><inertia><ixx>0.000125</ixx><iyy>0.000125</iyy><izz>0.000135</izz></inertia></inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.035</radius><length>0.040</length></cylinder></geometry>
        <material><ambient>0.03 0.04 0.05 1</ambient><diffuse>0.08 0.09 0.10 1</diffuse></material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <topic>/model/ground_vehicle/scan</topic>
        <gz_frame_id>laser_frame</gz_frame_id>
        <always_on>true</always_on><update_rate>6</update_rate><visualize>false</visualize>
        <lidar>
          <scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159265359</min_angle><max_angle>3.14159265359</max_angle></horizontal></scan>
          <range><min>0.12</min><max>20.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed"><parent>base_link</parent><child>laser_frame</child></joint>

    <!-- 车头相机：URDF camera_link 安装位 (0.185, 0, 0.105)，X 朝车头 -->
    <link name="camera_link">
      <pose relative_to="base_link">0.185 0 0.105 0 0 0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.080</mass><inertia><ixx>0.000015</ixx><iyy>0.000020</iyy><izz>0.000020</izz></inertia></inertial>
      <visual name="visual">
        <geometry><box><size>0.040 0.032 0.026</size></box></geometry>
        <material><ambient>0.02 0.20 0.45 1</ambient><diffuse>0.05 0.30 0.60 1</diffuse></material>
      </visual>
      <sensor name="front_camera" type="camera">
        <topic>/model/ground_vehicle/front_camera</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image><width>320</width><height>180</height><format>R8G8B8</format></image>
          <clip><near>0.08</near><far>30.0</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.003</stddev></noise>
        </camera>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>

    <link name="imu_link">
      <pose relative_to="base_link">0 0 0.04 0 0 0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.02</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
      <sensor name="imu" type="imu">
        <topic>/model/ground_vehicle/imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <always_on>true</always_on><update_rate>50</update_rate>
      </sensor>
    </link>
    <joint name="imu_mount" type="fixed"><parent>base_link</parent><child>imu_link</child></joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <wheel_separation>0.32</wheel_separation>
      <wheel_radius>0.076</wheel_radius>
      <topic>/model/ground_vehicle/cmd_vel</topic>
      <odom_topic>/model/ground_vehicle/odometry</odom_topic>
      <tf_topic>/model/ground_vehicle/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
    </plugin>
  </model>
</sdf>
