        "DESCEND": "AC_PRECLAND_LAND",
        "FINAL_APPROACH": "AC_PRECLAND_LAND"
      }
    }
  },
  "ros2_adapters": {
    "distribution": "humble",
    "elastic": {
      "input_topic": "/elastic_tracker/trajectory",
      "input_type": "trajectory_msgs/msg/MultiDOFJointTrajectory",
