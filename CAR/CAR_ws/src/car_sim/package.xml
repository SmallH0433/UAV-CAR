<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>car_sim</name>
  <version>0.2.0</version>
  <description>R680 仿真 + 实机部署：Gazebo 世界/桥配置、控制权 mux、指令网关、网页遥控、实机 bringup launch（移植自 air_ground_sim，不含 Nav2）</description>
  <maintainer email="yoimiya@todo.todo">yoimiya</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>car_description</exec_depend>
  <exec_depend>car_nodes</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
