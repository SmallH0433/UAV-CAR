      "ibvs_alignment_hold_s": 0.4,
      "require_ibvs_for_precland_handover": true,
      "maximum_target_feedforward_mps": 0.4,
      "maximum_total_horizontal_speed_mps": 0.10,
      "maximum_total_horizontal_acceleration_mps2": 0.15,
