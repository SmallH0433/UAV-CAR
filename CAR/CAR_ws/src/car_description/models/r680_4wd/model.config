<?xml version="1.0"?>
<model>
  <name>R680 Ackermann rover</name>
  <version>0.2.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>CAR Project</name>
  </author>
  <description>
    R680 Ackermann-steering rover (WHEELTEC chassis: servo-steered front
