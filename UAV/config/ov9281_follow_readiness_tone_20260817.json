{
  "version": 1,
  "scope": "ov9281_dual_tag_follow_readiness_tone_only",
  "flight_control_approved": false,
  "operator_start_policy": {
    "manual_start_only": true,
    "autostart_forbidden": true,
    "exit_on_rc7_high_after_ready": true,
    "conflicting_services": [
      "ov9281-follow-observer.service",
      "ov9281-follow-props-off-manual.service",
      "apriltag-follow-monitor.service"
    ]
  },
  "vision": {
    "status_url": "http://127.0.0.1:8765/api/status",
    "poll_hz": 10.0,
    "maximum_frame_age_ms": 150.0,
    "acquire_count": 5,
    "target_timeout_s": 0.25,
    "minimum_decision_margin": 30.0,
    "maximum_hamming": 0,
    "maximum_reprojection_error_px": 2.5,
    "minimum_pose_distance_m": 0.03,
    "maximum_pose_distance_m": 8.0,
    "accepted_tags": {
      "0": {
        "size_m": 0.100,
        "size_tolerance_m": 0.001,
        "role": "outer",
        "minimum_area_px2": 100.0,
        "minimum_decision_margin": 50.0,
        "maximum_hamming": 2,
        "maximum_reprojection_error_px": 1.0
      },
      "1": {
        "size_m": 0.020,
        "size_tolerance_m": 0.001,
        "role": "inner",
        "minimum_area_px2": 64.0,
        "minimum_decision_margin": 35.0,
        "maximum_hamming": 2,
        "maximum_reprojection_error_px": 1.5
      }
    }
  },
  "telemetry": {
    "device": "/dev/serial0",
    "baud": 57600,
    "source_system": 191,
    "source_component": 191,
    "heartbeat_timeout_s": 8.0,
    "stream_rate_hz": 10
  },
  "rc_authorization": {
    "channel": 7,
    "enable_pwm_min": 1800,
    "disable_pwm_max": 1200,
    "low_at_start_required": true
  },
  "readiness": {
    "telemetry_timeout_s": 1.5,
    "minimum_voltage_v": 21.6,
    "minimum_remaining_pct": 20,
    "battery_telemetry_required": false,
    "minimum_height_m": 0.5,
    "maximum_height_m": 1.5,
    "minimum_flow_quality": 80,
    "allowed_entry_modes": [
      "ALT_HOLD",
      "LOITER",
      "POSHOLD"
    ],
    "require_armed_for_ready_tone": true,
    "attitude_required": true,
    "ekf_relative_position_required": true,
    "ekf_origin_required": true
  },
  "tone": {
    "event": "OBSERVE_READY",
    "tune": "MFT200L8O5C",
    "meaning": "single C: all follow prerequisites ready; RC7 may be enabled",
    "rearm_after_not_ready_s": 2.0
  },
  "safety": {
    "tone_only": true,
    "telemetry_stream_request": true,
    "play_tune": true,
    "parameter_write": false,
    "mode_change": false,
    "movement_setpoint": false,
    "arm_command": false,
    "takeoff_command": false,
    "land_command": false,
    "motor_command": false
  },
  "output": {
    "status": "/home/PI/ov9281_debug/follow_readiness_tone_status.json",
    "log": "/home/PI/ov9281_debug/follow_readiness_tone.jsonl",
    "status_rate_hz": 5.0
  }
}
