      "abort_below_pwm": 1300,
      "standby_band_pwm": [1301, 1799],
      "authorize_above_pwm": 1800,
      "maximum_age_s": 0.5,
      "ardupilot_rc_option": "NONE_companion_reads_raw_channel"
    },
    "landing_request": {
      "role": "descent_toggle_during_confirmed_follow",
      "operator_control": "SwD",
      "candidate_channel": 8,
      "off_below_pwm": 1200,
      "on_above_pwm": 1800,
      "maximum_age_s": 0.5,
      "require_confirmed_guided_follow": true,
      "require_off_to_on_edge_after_follow": true,
      "on_action": "request_ac_precland_land_while_following",
      "off_action": "cancel_descent_and_resume_guided_height_follow",
      "ardupilot_rc_option": "NONE_companion_reads_raw_channel",
