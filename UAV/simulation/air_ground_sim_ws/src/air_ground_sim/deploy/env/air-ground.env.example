ROS_DOMAIN_ID=42
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
ROS_SECURITY_ENABLE=true
ROS_SECURITY_STRATEGY=Enforce
ROS_SECURITY_KEYSTORE=/etc/air-ground/keystore
AIR_GROUND_CONTROL_TOKEN=replace-with-at-least-32-random-characters
AIR_GROUND_EVENT_LOG=/var/lib/air-ground/system-events.jsonl
AIR_GROUND_GATEWAY_AUDIT_LOG=/var/lib/air-ground/gateway-audit.jsonl
