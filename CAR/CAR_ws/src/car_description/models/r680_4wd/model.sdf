<?xml version="1.0"?>
<sdf version="1.9">
  <!-- R680 阿克曼转向小车（WHEELTEC 底盘：前轮舵机转向 + 后轮双电机驱动）
       几何/惯性按 car_description/urdf/CAR_description.urdf 换算：
       底盘 465x385x218 mm；顶部 450x450 mm 无人机停机坪 + 居中机构
       （2 台双出轴 42 步进 + T8 双向丝杆，4 个 "[" 型推杆）。
       轮半径 0.076 m，轮距 0.32 m，轴距 0.31 m，底盘 16 kg。
       世界文件中以 <name>ground_vehicle</name> 包含，故 gz topic 前缀为
       /model/ground_vehicle/... -->
  <model name="r680_4wd">
    <self_collide>false</self_collide>

    <link name="base_link">
      <!-- base_link 与轮轴同高（轮半径 0.076） -->
      <pose>0 0 0.076 0 0 0</pose>
      <inertial>
        <mass>16.0</mass>
        <pose>0 0 0.070 0 0 0</pose>
        <inertia>
          <ixx>0.104700</ixx><iyy>0.144033</iyy><izz>0.233733</izz>
        </inertia>
      </inertial>
      <!-- 简化碰撞体：底部距地约 81 mm，不遮挡车轮 -->
      <collision name="body_collision">
        <pose>0 0 0.070 0 0 0</pose>
        <geometry><box><size>0.320 0.270 0.130</size></box></geometry>
      </collision>
      <visual name="body_visual">
        <pose>0 0 0.070 0 0 0</pose>
        <geometry><box><size>0.320 0.270 0.130</size></box></geometry>
        <material>
          <ambient>0.10 0.11 0.12 1</ambient>
          <diffuse>0.20 0.22 0.24 1</diffuse>
        </material>
      </visual>
      <!-- 上层安装铝板 -->
      <visual name="deck_visual">
        <pose>0 0 0.136 0 0 0</pose>
        <geometry><box><size>0.340 0.285 0.012</size></box></geometry>
        <material>
          <ambient>0.60 0.62 0.65 1</ambient>
          <diffuse>0.72 0.75 0.78 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- 无人机停机坪：450x450x12 mm。平台以四根立柱架高，底面相对
         base_link 为 0.224 m，高于激光雷达顶面 42 mm，避免几何互穿。
         停机坪为固定载荷，不改变底盘轴距、轮距、转向限位和驱动参数。 -->
    <link name="landing_pad_link">
      <pose relative_to="base_link">0 0 0.230 0 0 0</pose>
      <inertial>
        <mass>1.20</mass>
        <inertia>
          <ixx>0.022090</ixx><iyy>0.022090</iyy><izz>0.044180</izz>
        </inertia>
      </inertial>
      <collision name="pad_collision">
        <geometry><box><size>0.470 0.470 0.012</size></box></geometry>
      </collision>
      <visual name="pad_visual">
        <geometry><box><size>0.470 0.470 0.012</size></box></geometry>
        <material><ambient>0.08 0.08 0.09 1</ambient><diffuse>0.16 0.16 0.18 1</diffuse></material>
      </visual>
      <!-- 白色 H 标识（仅视觉层，略高于平台表面防止闪烁）。 -->
      <visual name="landing_h_left">
        <pose>0 0.065 0.0065 0 0 0</pose>
        <geometry><box><size>0.180 0.030 0.001</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual>
      <visual name="landing_h_right">
        <pose>0 -0.065 0.0065 0 0 0</pose>
        <geometry><box><size>0.180 0.030 0.001</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual>
      <visual name="landing_h_crossbar">
        <pose>0 0 0.0065 0 0 0</pose>
        <geometry><box><size>0.030 0.130 0.001</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse></material>
      </visual>
      <!-- 支撑柱坐标相对停机坪中心：柱中心低于平台 47 mm。支柱只作
           视觉建模，避免同车激光雷达把它们识别为 0.13~0.30 m 近障；
           平台主体仍保留完整碰撞体，平面外廓由避障 footprint 覆盖。 -->
      <visual name="front_left_support_visual"><pose>0.150 0.150 -0.047 0 0 0</pose><geometry><cylinder><radius>0.008</radius><length>0.082</length></cylinder></geometry><material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.72 0.75 0.78 1</diffuse></material><visibility_flags>2</visibility_flags></visual>
      <visual name="front_right_support_visual"><pose>0.150 -0.150 -0.047 0 0 0</pose><geometry><cylinder><radius>0.008</radius><length>0.082</length></cylinder></geometry><material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.72 0.75 0.78 1</diffuse></material><visibility_flags>2</visibility_flags></visual>
      <visual name="rear_left_support_visual"><pose>-0.150 0.150 -0.047 0 0 0</pose><geometry><cylinder><radius>0.008</radius><length>0.082</length></cylinder></geometry><material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.72 0.75 0.78 1</diffuse></material><visibility_flags>2</visibility_flags></visual>
      <visual name="rear_right_support_visual"><pose>-0.150 -0.150 -0.047 0 0 0</pose><geometry><cylinder><radius>0.008</radius><length>0.082</length></cylinder></geometry><material><ambient>0.55 0.57 0.60 1</ambient><diffuse>0.72 0.75 0.78 1</diffuse></material><visibility_flags>2</visibility_flags></visual>
    </link>
    <joint name="landing_pad_joint" type="fixed"><parent>base_link</parent><child>landing_pad_link</child></joint>

    <!-- ========== 停机坪居中机构（固件见 tools/leadscrew42） ==========
         布局（俯视，+X=车头=A 边，顺时针 B(-Y 右) C(-X 后) D(+Y 左)）：
           电机A 挂在 A 边中点下方 (0.235, 0)，丝杆轴沿 Y；
           电机B 挂在 B 边中点下方 (0, -0.235)，丝杆轴沿 X。
         电机 42x42x60 mm（加长机身）；T8 丝杆 ⌀8，自电机两端面各伸出
         150 mm（丝杆全长 300 mm，含电机总长 360 mm，即末端距电机中心
         180 mm；螺距 2 导程 2，双向牙）。
         螺母套 20(沿丝杆)x20x15 mm，丝杆穿过 20x15 面几何中心。
         行程约束：螺母中心距电机中心 113 mm(内，距电机端面 53 mm)~
         180 mm(外，螺母端面与丝杆末端齐平，不超出丝杆)，
         单边行程 67 mm —— 与固件 TRAVEL_MM=67 一致。
         4 个 "[" 型推杆（10x10 方杆）与各自螺母套刚性一体：
           组1(电机A) pusher_a/pusher_c 横跨 A↔C，横臂距坪面 h1=30 mm；
           组2(电机B) pusher_b/pusher_d 横跨 B↔D，横臂距坪面 h2=55 mm；
           h1 != h2 保证十字交叉处不碰撞。垂腿落在坪边外侧 5 mm。
         棱柱关节语义：q=0 螺母在外侧（对应固件 pos=0 / AT_OUTER），
         q=-0.067 到内侧（pos=67 mm / AT_INNER）；ROS 侧换算见
         car_nodes/leadscrew_driver.py 仿真模式。
         控制：JointPositionController x4（topic pusher_{a,b,c,d}/cmd_pos，
         Float64）+ JointStatePublisher（joint_states）。 -->
    <link name="screw_motor_a_link">
      <pose relative_to="landing_pad_link">0.235 0 -0.027 0 0 0</pose>
      <inertial><mass>0.28</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
      <collision name="motor_collision">
        <geometry><box><size>0.042 0.060 0.042</size></box></geometry>
      </collision>
      <visual name="motor_visual">
        <geometry><box><size>0.042 0.060 0.042</size></box></geometry>
        <material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.20 0.20 0.25 1</diffuse></material>
      </visual>
      <!-- T8 丝杆（中段 40mm 藏于电机体内）：轴沿 Y -->
      <visual name="screw_visual">
        <pose>0 0 0 1.57079632679 0 0</pose>
        <geometry><cylinder><radius>0.004</radius><length>0.360</length></cylinder></geometry>
        <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.70 0.70 0.73 1</diffuse></material>
      </visual>
    </link>
    <joint name="screw_motor_a_joint" type="fixed"><parent>landing_pad_link</parent><child>screw_motor_a_link</child></joint>

    <link name="screw_motor_b_link">
      <pose relative_to="landing_pad_link">0 -0.235 -0.027 0 0 0</pose>
      <inertial><mass>0.28</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
      <collision name="motor_collision">
        <geometry><box><size>0.060 0.042 0.042</size></box></geometry>
      </collision>
      <visual name="motor_visual">
        <geometry><box><size>0.060 0.042 0.042</size></box></geometry>
        <material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.20 0.20 0.25 1</diffuse></material>
      </visual>
      <!-- T8 丝杆：轴沿 X -->
      <visual name="screw_visual">
        <pose>0 0 0 0 1.57079632679 0</pose>
        <geometry><cylinder><radius>0.004</radius><length>0.360</length></cylinder></geometry>
        <material><ambient>0.55 0.55 0.58 1</ambient><diffuse>0.70 0.70 0.73 1</diffuse></material>
      </visual>
    </link>
    <joint name="screw_motor_b_joint" type="fixed"><parent>landing_pad_link</parent><child>screw_motor_b_link</child></joint>

    <!-- 俯视相机：停机坪正上方 650mm 垂直向下（仿真监控台 /sim 的
         实时俯视图画面）。传感器 +Z（图像上方）朝车头，A 边在画面上方。 -->
    <link name="top_camera_link">
      <pose relative_to="landing_pad_link">0 0 0.650 0 1.57079632679 0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.050</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
      <sensor name="top_camera" type="camera">
        <topic>/model/ground_vehicle/top_camera/image</topic>
        <gz_frame_id>top_camera_link</gz_frame_id>
        <always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
        <camera>
          <horizontal_fov>0.9</horizontal_fov>
          <image><width>480</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>10.0</far></clip>
        </camera>
      </sensor>
    </link>
    <joint name="top_camera_joint" type="fixed"><parent>landing_pad_link</parent><child>top_camera_link</child></joint>

    <!-- 组1 推杆（横跨 A↔C，h1=30mm）：link 原点 = 螺母套中心（q=0 即外侧位） -->
    <link name="pusher_a_link">
      <pose relative_to="landing_pad_link">0.235 -0.170 -0.027 0 0 0</pose>
      <inertial><mass>0.15</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
      <collision name="nut_collision">
        <geometry><box><size>0.020 0.020 0.015</size></box></geometry>
      </collision>
      <visual name="nut_visual">
        <geometry><box><size>0.020 0.020 0.015</size></box></geometry>
        <material><ambient>0.55 0.27 0.02 1</ambient><diffuse>0.70 0.35 0.05 1</diffuse></material>
      </visual>
      <!-- 近腿（A 边外侧 x=+0.230）/ 横臂（沿 X，高 h1）/ 远腿（C 边外侧 x=-0.230） -->
      <visual name="leg_near"><pose>0.005 0 0.03525 0 0 0</pose><geometry><box><size>0.010 0.010 0.0555</size></box></geometry><material><ambient>0.05 0.25 0.45 1</ambient><diffuse>0.10 0.35 0.60 1</diffuse></material></visual>
      <collision name="arm_collision"><pose>-0.235 0 0.063 0 0 0</pose><geometry><box><size>0.480 0.010 0.010</size></box></geometry></collision>
      <visual name="arm"><pose>-0.235 0 0.063 0 0 0</pose><geometry><box><size>0.480 0.010 0.010</size></box></geometry><material><ambient>0.05 0.25 0.45 1</ambient><diffuse>0.10 0.35 0.60 1</diffuse></material></visual>
      <visual name="leg_far"><pose>-0.475 0 0.03525 0 0 0</pose><geometry><box><size>0.010 0.010 0.0555</size></box></geometry><material><ambient>0.05 0.25 0.45 1</ambient><diffuse>0.10 0.35 0.60 1</diffuse></material></visual>
    </link>
    <joint name="pusher_a_joint" type="prismatic">
      <parent>landing_pad_link</parent><child>pusher_a_link</child>
      <axis><xyz>0 -1 0</xyz><limit><lower>-0.067</lower><upper>0.0</upper><effort>10.0</effort><velocity>0.05</velocity></limit></axis>
    </joint>

    <link name="pusher_c_link">
      <pose relative_to="landing_pad_link">0.235 0.170 -0.027 0 0 0</pose>
      <inertial><mass>0.15</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
      <collision name="nut_collision">
        <geometry><box><size>0.020 0.020 0.015</size></box></geometry>
      </collision>
      <visual name="nut_visual">
        <geometry><box><size>0.020 0.020 0.015</size></box></geometry>
        <material><ambient>0.55 0.27 0.02 1</ambient><diffuse>0.70 0.35 0.05 1</diffuse></material>
      </visual>
      <visual name="leg_near"><pose>0.005 0 0.03525 0 0 0</pose><geometry><box><size>0.010 0.010 0.0555</size></box></geometry><material><ambient>0.05 0.25 0.45 1</ambient><diffuse>0.10 0.35 0.60 1</diffuse></material></visual>
      <collision name="arm_collision"><pose>-0.235 0 0.063 0 0 0</pose><geometry><box><size>0.480 0.010 0.010</size></box></geometry></collision>
      <visual name="arm"><pose>-0.235 0 0.063 0 0 0</pose><geometry><box><size>0.480 0.010 0.010</size></box></geometry><material><ambient>0.05 0.25 0.45 1</ambient><diffuse>0.10 0.35 0.60 1</diffuse></material></visual>
      <visual name="leg_far"><pose>-0.475 0 0.03525 0 0 0</pose><geometry><box><size>0.010 0.010 0.0555</size></box></geometry><material><ambient>0.05 0.25 0.45 1</ambient><diffuse>0.10 0.35 0.60 1</diffuse></material></visual>
    </link>
    <joint name="pusher_c_joint" type="prismatic">
      <parent>landing_pad_link</parent><child>pusher_c_link</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-0.067</lower><upper>0.0</upper><effort>10.0</effort><velocity>0.05</velocity></limit></axis>
    </joint>

    <!-- 组2 推杆（横跨 B↔D，h2=55mm） -->
    <link name="pusher_b_link">
      <pose relative_to="landing_pad_link">0.160 -0.235 -0.027 0 0 0</pose>
      <inertial><mass>0.15</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
      <collision name="nut_collision">
        <geometry><box><size>0.020 0.020 0.015</size></box></geometry>
      </collision>
      <visual name="nut_visual">
        <geometry><box><size>0.020 0.020 0.015</size></box></geometry>
        <material><ambient>0.55 0.27 0.02 1</ambient><diffuse>0.70 0.35 0.05 1</diffuse></material>
      </visual>
      <!-- 近腿（B 边外侧 y=-0.230）/ 横臂（沿 Y，高 h2）/ 远腿（D 边外侧 y=+0.230） -->
      <visual name="leg_near"><pose>0 -0.005 0.04775 0 0 0</pose><geometry><box><size>0.010 0.010 0.0805</size></box></geometry><material><ambient>0.45 0.10 0.35 1</ambient><diffuse>0.60 0.15 0.50 1</diffuse></material></visual>
      <collision name="arm_collision"><pose>0 0.235 0.088 0 0 0</pose><geometry><box><size>0.010 0.480 0.010</size></box></geometry></collision>
      <visual name="arm"><pose>0 0.235 0.088 0 0 0</pose><geometry><box><size>0.010 0.480 0.010</size></box></geometry><material><ambient>0.45 0.10 0.35 1</ambient><diffuse>0.60 0.15 0.50 1</diffuse></material></visual>
      <visual name="leg_far"><pose>0 0.475 0.04775 0 0 0</pose><geometry><box><size>0.010 0.010 0.0805</size></box></geometry><material><ambient>0.45 0.10 0.35 1</ambient><diffuse>0.60 0.15 0.50 1</diffuse></material></visual>
    </link>
    <joint name="pusher_b_joint" type="prismatic">
      <parent>landing_pad_link</parent><child>pusher_b_link</child>
      <axis><xyz>1 0 0</xyz><limit><lower>-0.067</lower><upper>0.0</upper><effort>10.0</effort><velocity>0.05</velocity></limit></axis>
    </joint>

    <link name="pusher_d_link">
      <pose relative_to="landing_pad_link">-0.160 -0.235 -0.027 0 0 0</pose>
      <inertial><mass>0.15</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
      <collision name="nut_collision">
        <geometry><box><size>0.020 0.020 0.015</size></box></geometry>
      </collision>
      <visual name="nut_visual">
        <geometry><box><size>0.020 0.020 0.015</size></box></geometry>
        <material><ambient>0.55 0.27 0.02 1</ambient><diffuse>0.70 0.35 0.05 1</diffuse></material>
      </visual>
      <visual name="leg_near"><pose>0 -0.005 0.04775 0 0 0</pose><geometry><box><size>0.010 0.010 0.0805</size></box></geometry><material><ambient>0.45 0.10 0.35 1</ambient><diffuse>0.60 0.15 0.50 1</diffuse></material></visual>
      <collision name="arm_collision"><pose>0 0.235 0.088 0 0 0</pose><geometry><box><size>0.010 0.480 0.010</size></box></geometry></collision>
      <visual name="arm"><pose>0 0.235 0.088 0 0 0</pose><geometry><box><size>0.010 0.480 0.010</size></box></geometry><material><ambient>0.45 0.10 0.35 1</ambient><diffuse>0.60 0.15 0.50 1</diffuse></material></visual>
      <visual name="leg_far"><pose>0 0.475 0.04775 0 0 0</pose><geometry><box><size>0.010 0.010 0.0805</size></box></geometry><material><ambient>0.45 0.10 0.35 1</ambient><diffuse>0.60 0.15 0.50 1</diffuse></material></visual>
    </link>
    <joint name="pusher_d_joint" type="prismatic">
      <parent>landing_pad_link</parent><child>pusher_d_link</child>
      <axis><xyz>-1 0 0</xyz><limit><lower>-0.067</lower><upper>0.0</upper><effort>10.0</effort><velocity>0.05</velocity></limit></axis>
    </joint>

    <!-- 推杆关节位置控制（每关节一个实例；q=0 外侧，-0.057 内侧） -->
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>pusher_a_joint</joint_name>
      <topic>/model/ground_vehicle/pusher_a/cmd_pos</topic>
      <initial_position>0.0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>pusher_c_joint</joint_name>
      <topic>/model/ground_vehicle/pusher_c/cmd_pos</topic>
      <initial_position>0.0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>pusher_b_joint</joint_name>
      <topic>/model/ground_vehicle/pusher_b/cmd_pos</topic>
      <initial_position>0.0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-position-controller-system" name="gz::sim::systems::JointPositionController">
      <joint_name>pusher_d_joint</joint_name>
      <topic>/model/ground_vehicle/pusher_d/cmd_pos</topic>
      <initial_position>0.0</initial_position>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system" name="gz::sim::systems::JointStatePublisher">
      <joint_name>pusher_a_joint</joint_name>
      <joint_name>pusher_b_joint</joint_name>
      <joint_name>pusher_c_joint</joint_name>
      <joint_name>pusher_d_joint</joint_name>
      <topic>/model/ground_vehicle/joint_states</topic>
    </plugin>
    <!-- 注：推杆实际位置核对用 SceneBroadcaster 的
         /world/r680_test_field/dynamic_pose/info（joint_states 只含关节元数据） -->

    <!-- 前轮转向节（kingpin）：垂直轴 revolute 关节挂在 base_link 下，
         前轮滚转关节再挂到转向节下。转向角限位 ±0.5 rad（约 28.6°），
         正转向角 = 左转（绕 +Z 逆时针）。 -->
    <link name="front_left_steer_link">
      <pose>0.155 0.160 0.076 0 0 0</pose>
      <inertial><mass>0.3</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
      <visual name="visual">
        <geometry><box><size>0.030 0.030 0.060</size></box></geometry>
        <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.45 0.45 0.48 1</diffuse></material>
      </visual>
    </link>
    <link name="front_right_steer_link">
      <pose>0.155 -0.160 0.076 0 0 0</pose>
      <inertial><mass>0.3</mass><inertia><ixx>0.0001</ixx><iyy>0.0001</iyy><izz>0.0001</izz></inertia></inertial>
      <visual name="visual">
        <geometry><box><size>0.030 0.030 0.060</size></box></geometry>
        <material><ambient>0.30 0.30 0.32 1</ambient><diffuse>0.45 0.45 0.48 1</diffuse></material>
      </visual>
    </link>

    <!-- 车轮 link 滚转 +90 度，关节局部 Z 轴即轮轴（指向车体 -Y 右侧）；
         取关节轴 -Z（即车体 +Y），使正关节速度驱动车辆向 +X 前进。
         阿克曼底盘车轮纯滚动无侧滑，mu/mu2 均为 1.0（不再需要滑移转向的
         低横向摩擦）。 -->
    <link name="front_left_wheel_link">
      <pose>0.155 0.160 0.076 1.57079632679 0 0</pose>
      <inertial><mass>1.2</mass><inertia><ixx>0.0021553</ixx><iyy>0.0021553</iyy><izz>0.0034656</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.076</radius><length>0.065</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.076</radius><length>0.065</length></cylinder></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <link name="front_right_wheel_link">
      <pose>0.155 -0.160 0.076 1.57079632679 0 0</pose>
      <inertial><mass>1.2</mass><inertia><ixx>0.0021553</ixx><iyy>0.0021553</iyy><izz>0.0034656</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.076</radius><length>0.065</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.076</radius><length>0.065</length></cylinder></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <link name="rear_left_wheel_link">
      <pose>-0.155 0.160 0.076 1.57079632679 0 0</pose>
      <inertial><mass>1.2</mass><inertia><ixx>0.0021553</ixx><iyy>0.0021553</iyy><izz>0.0034656</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.076</radius><length>0.065</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.076</radius><length>0.065</length></cylinder></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>
    <link name="rear_right_wheel_link">
      <pose>-0.155 -0.160 0.076 1.57079632679 0 0</pose>
      <inertial><mass>1.2</mass><inertia><ixx>0.0021553</ixx><iyy>0.0021553</iyy><izz>0.0034656</izz></inertia></inertial>
      <collision name="collision">
        <geometry><cylinder><radius>0.076</radius><length>0.065</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>0.076</radius><length>0.065</length></cylinder></geometry>
        <material><ambient>0.02 0.02 0.02 1</ambient><diffuse>0.05 0.05 0.05 1</diffuse></material>
      </visual>
    </link>

    <joint name="front_left_steer_joint" type="revolute">
      <parent>base_link</parent><child>front_left_steer_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.5</lower><upper>0.5</upper><effort>10.0</effort><velocity>5.0</velocity></limit></axis>
    </joint>
    <joint name="front_right_steer_joint" type="revolute">
      <parent>base_link</parent><child>front_right_steer_link</child>
      <axis><xyz>0 0 1</xyz><limit><lower>-0.5</lower><upper>0.5</upper><effort>10.0</effort><velocity>5.0</velocity></limit></axis>
    </joint>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>front_left_steer_link</parent><child>front_left_wheel_link</child>
      <axis><xyz>0 0 -1</xyz><limit><lower>-1.0e16</lower><upper>1.0e16</upper></limit></axis>
    </joint>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>front_right_steer_link</parent><child>front_right_wheel_link</child>
      <axis><xyz>0 0 -1</xyz><limit><lower>-1.0e16</lower><upper>1.0e16</upper></limit></axis>
    </joint>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel_link</child>
      <axis><xyz>0 0 -1</xyz><limit><lower>-1.0e16</lower><upper>1.0e16</upper></limit></axis>
    </joint>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel_link</child>
      <axis><xyz>0 0 -1</xyz><limit><lower>-1.0e16</lower><upper>1.0e16</upper></limit></axis>
    </joint>

    <!-- 顶部激光雷达：URDF laser_frame 安装位 (0.100, 0, 0.162) -->
    <link name="laser_frame">
      <pose relative_to="base_link">0.100 0 0.162 0 0 0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.220</mass><inertia><ixx>0.000125</ixx><iyy>0.000125</iyy><izz>0.000135</izz></inertia></inertial>
      <visual name="visual">
        <geometry><cylinder><radius>0.035</radius><length>0.040</length></cylinder></geometry>
        <material><ambient>0.03 0.04 0.05 1</ambient><diffuse>0.08 0.09 0.10 1</diffuse></material>
      </visual>
      <sensor name="lidar" type="gpu_lidar">
        <topic>/model/ground_vehicle/scan</topic>
        <gz_frame_id>laser_frame</gz_frame_id>
        <always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
        <lidar>
          <!-- 只扫描 visibility flag bit 0；支柱使用 bit 1，GUI/相机仍可见。 -->
          <visibility_mask>1</visibility_mask>
          <scan><horizontal><samples>360</samples><resolution>1</resolution><min_angle>-3.14159265359</min_angle><max_angle>3.14159265359</max_angle></horizontal></scan>
          <range><min>0.12</min><max>25.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>
    </link>
    <joint name="lidar_joint" type="fixed"><parent>base_link</parent><child>laser_frame</child></joint>

    <!-- 车头相机：URDF camera_link 安装位 (0.185, 0, 0.105)，X 朝车头 -->
    <link name="camera_link">
      <pose relative_to="base_link">0.185 0 0.105 0 0 0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.080</mass><inertia><ixx>0.000015</ixx><iyy>0.000020</iyy><izz>0.000020</izz></inertia></inertial>
      <visual name="visual">
        <geometry><box><size>0.040 0.032 0.026</size></box></geometry>
        <material><ambient>0.02 0.20 0.45 1</ambient><diffuse>0.05 0.30 0.60 1</diffuse></material>
      </visual>
      <sensor name="front_camera" type="camera">
        <topic>/model/ground_vehicle/front_camera</topic>
        <gz_frame_id>camera_link</gz_frame_id>
        <always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image><width>320</width><height>180</height><format>R8G8B8</format></image>
          <clip><near>0.08</near><far>30.0</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.003</stddev></noise>
        </camera>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>

    <!-- 车尾相机：与车头相机同高对称安装，绕 Z 转 π 使 X 朝车尾 -->
    <link name="rear_camera_link">
      <pose relative_to="base_link">-0.185 0 0.105 0 0 3.14159265359</pose>
      <gravity>false</gravity>
      <inertial><mass>0.080</mass><inertia><ixx>0.000015</ixx><iyy>0.000020</iyy><izz>0.000020</izz></inertia></inertial>
      <visual name="visual">
        <geometry><box><size>0.040 0.032 0.026</size></box></geometry>
        <material><ambient>0.45 0.10 0.02 1</ambient><diffuse>0.60 0.18 0.05 1</diffuse></material>
      </visual>
      <sensor name="rear_camera" type="camera">
        <!-- 注意：gz camera_info 发布在图像话题的父路径 + /camera_info，
             嵌套一层使后摄 camera_info 落在独立话题，不与前摄混流 -->
        <topic>/model/ground_vehicle/rear_camera/image</topic>
        <gz_frame_id>rear_camera_link</gz_frame_id>
        <always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
        <camera>
          <horizontal_fov>1.3962634</horizontal_fov>
          <image><width>320</width><height>180</height><format>R8G8B8</format></image>
          <clip><near>0.08</near><far>30.0</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.003</stddev></noise>
        </camera>
      </sensor>
    </link>
    <joint name="rear_camera_joint" type="fixed"><parent>base_link</parent><child>rear_camera_link</child></joint>

    <link name="imu_link">
      <pose relative_to="base_link">0 0 0.04 0 0 0</pose>
      <gravity>false</gravity>
      <inertial><mass>0.02</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz></inertia></inertial>
      <sensor name="imu" type="imu">
        <topic>/model/ground_vehicle/imu</topic>
        <gz_frame_id>imu_link</gz_frame_id>
        <always_on>true</always_on><update_rate>50</update_rate>
      </sensor>
    </link>
    <joint name="imu_mount" type="fixed"><parent>base_link</parent><child>imu_link</child></joint>

    <!-- 阿克曼转向插件：收 Twist cmd_vel，内部解算左右前轮转向角（满足
         阿克曼几何）与后轮驱动速度；话题与里程计契约与原差速插件一致。 -->
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_steering_joint>front_left_steer_joint</left_steering_joint>
      <right_steering_joint>front_right_steer_joint</right_steering_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <steering_limit>0.5</steering_limit>
      <wheel_base>0.31</wheel_base>
      <kingpin_width>0.32</kingpin_width>
      <wheel_separation>0.32</wheel_separation>
      <wheel_radius>0.076</wheel_radius>
      <topic>/model/ground_vehicle/cmd_vel</topic>
      <odom_topic>/model/ground_vehicle/odometry</odom_topic>
      <tf_topic>/model/ground_vehicle/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_footprint</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <max_angular_acceleration>2.0</max_angular_acceleration>
    </plugin>
  </model>
</sdf>
