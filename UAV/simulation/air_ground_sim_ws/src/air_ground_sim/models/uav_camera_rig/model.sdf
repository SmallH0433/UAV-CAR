<?xml version='1.0'?>
<sdf version="1.9">
  <model name="uav_camera_rig">
    <include>
      <uri>model://iris_with_standoffs</uri>
    </include>

    <!-- Top-level attachment link for Gazebo's DetachableJoint system.  The
         included Iris base link is nested, while DetachableJoint resolves an
         exact direct child link of the selected child model. -->
    <link name="dock_link">
      <pose relative_to="iris_with_standoffs::base_link">0 0 -0.10 0 0 0</pose>
      <gravity>false</gravity>
      <inertial>
        <mass>0.001</mass>
        <inertia>
          <ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz>
        </inertia>
      </inertial>
    </link>
    <joint name="dock_mount" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>dock_link</child>
    </joint>

    <link name="ov9281_down_link">
      <!-- Belly-mounted monochrome global-shutter OV9281. The 2x2-binned
           640x400 stream is shared by optical flow and AprilTag tracking. -->
      <pose relative_to="iris_with_standoffs::base_link">0.05 0 -0.09 0 0 0</pose>
      <gravity>false</gravity>
      <inertial>
        <mass>0.025</mass>
        <inertia>
          <ixx>0.00001</ixx>
          <iyy>0.00001</iyy>
          <izz>0.00001</izz>
        </inertia>
      </inertial>
      <visual name="camera_body">
        <geometry>
          <box><size>0.04 0.04 0.018</size></box>
        </geometry>
        <material>
          <ambient>0.08 0.08 0.08 1</ambient>
          <diffuse>0.08 0.08 0.08 1</diffuse>
        </material>
      </visual>
      <sensor name="ov9281_down" type="camera">
        <!-- Gazebo cameras look along +X; +90 deg pitch points +X toward world -Z. -->
        <pose>0 0 -0.012 0 1.57079632679 0</pose>
        <topic>/uav/downward/image</topic>
        <gz_frame_id>uav_camera_optical_frame</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <visualize>false</visualize>
        <camera>
          <!-- 130-degree horizontal FOV gives about 116 degrees vertically at
               4:3.  The marker's coded region remains visible at the 0.60 m
               capture gate while retaining roughly 30 px at acquisition. -->
          <horizontal_fov>2.26892802759</horizontal_fov>
          <image>
            <width>640</width>
            <height>400</height>
            <format>L8</format>
          </image>
          <clip>
            <near>0.04</near>
            <far>30.0</far>
          </clip>
          <noise>
            <type>gaussian</type>
            <mean>0.0</mean>
            <stddev>0.002</stddev>
          </noise>
        </camera>
      </sensor>
    </link>

    <joint name="ov9281_down_mount" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>ov9281_down_link</child>
    </joint>

    <!-- Flight-navigation sensor pod. The included Iris already owns the
         1 kHz flight IMU; this link adds the external sensors that map to a
         real GNSS/compass mast and flight-controller barometer. -->
    <link name="avionics_sensor_link">
      <pose relative_to="iris_with_standoffs::base_link">0 0 0.11 0 0 0</pose>
      <gravity>false</gravity>
      <inertial>
        <mass>0.045</mass>
        <inertia><ixx>0.00004</ixx><iyy>0.00004</iyy><izz>0.00004</izz></inertia>
      </inertial>
      <visual name="gnss_compass_body">
        <geometry><cylinder><radius>0.030</radius><length>0.018</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.16 0.16 0.16 1</diffuse></material>
      </visual>
      <sensor name="gnss_receiver" type="navsat">
        <topic>/uav/gnss/fix</topic>
        <gz_frame_id>uav_gnss_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>10</update_rate>
      </sensor>
      <sensor name="hmc5883_magnetometer" type="magnetometer">
        <topic>/uav/magnetometer</topic>
        <gz_frame_id>uav_magnetometer_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <magnetometer>
          <x><noise type="gaussian"><mean>0</mean><stddev>0.000002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0</mean><stddev>0.000002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0</mean><stddev>0.0000025</stddev></noise></z>
        </magnetometer>
      </sensor>
      <sensor name="barometer" type="air_pressure">
        <topic>/uav/barometer</topic>
        <gz_frame_id>uav_barometer_link</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>50</update_rate>
        <air_pressure>
          <pressure><noise type="gaussian"><mean>0</mean><stddev>0.8</stddev></noise></pressure>
        </air_pressure>
      </sensor>
    </link>

    <joint name="avionics_sensor_mount" type="fixed">
      <parent>iris_with_standoffs::base_link</parent>
      <child>avionics_sensor_link</child>
    </joint>

    <!-- Downward ToF/LiDAR gives optical-flow scale and deck-relative height.
         A narrow nine-ray fan is used instead of a perfect single ray so
         small pitch/roll excursions do not immediately lose the deck. -->
    <link name="downward_tof_link">
      <pose relative_to="iris_with_standoffs::base_link">-0.04 0 -0.10 0 0 0</pose>
      <gravity>false</gravity>
      <inertial>
        <mass>0.012</mass>
        <inertia><ixx>0.000004</ixx><iyy>0.000004</iyy><izz>0.000004</izz></inertia>
      </inertial>
      <visual name="tof_body">
        <geometry><box><size>0.025 0.025 0.012</size></box></geometry>
        <material><ambient>0.04 0.04 0.05 1</ambient><diffuse>0.10 0.10 0.12 1</diffuse></material>
      </visual>
      <sensor name="downward_tof" type="gpu_lidar">
        <pose>0 0 -0.012 0 1.57079632679 0</pose>
        <topic>/uav/downward_tof</topic>
        <gz_frame_id>uav_downward_tof_frame</gz_frame_id>
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <visualize>false</visualize>
        <lidar>
          <scan><horizontal><samples>9</samples><resolution>1</resolution><min_angle>-0.05236</min_angle><max_angle>0.05236</max_angle></horizontal></scan>
          <range><min>0.05</min><max>8.0</max><resolution>0.005</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </lidar>
      </sensor>
    </link>
    <joint name="downward_tof_mount" type="fixed">
      <parent>iris_with_standoffs::base_link</parent><child>downward_tof_link</child>
    </joint>

    <!-- Frame-synchronized forward OV9281 pair. Gazebo renders complete frames
         (global-shutter equivalent); equal timing and intrinsics model the
         shared hardware trigger. RGB-D is a simulation-only stand-in for the
         disparity/depth product generated by stereo_image_proc on hardware. -->
    <link name="stereo_rig_link">
      <pose relative_to="iris_with_standoffs::base_link">0.16 0 0.02 0 0 0</pose>
      <gravity>false</gravity>
      <inertial>
        <mass>0.070</mass>
        <inertia><ixx>0.00012</ixx><iyy>0.00014</iyy><izz>0.00014</izz></inertia>
      </inertial>
      <visual name="stereo_bar">
        <geometry><box><size>0.055 0.14 0.04</size></box></geometry>
        <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <sensor name="ov9281_stereo_left" type="camera">
        <pose>0 0.06 0 0 0 0</pose>
        <topic>/uav/stereo/left/image</topic>
        <gz_frame_id>uav_stereo_left_optical_frame</gz_frame_id>
        <always_on>false</always_on><update_rate>20</update_rate><visualize>false</visualize>
        <camera>
          <horizontal_fov>1.57079632679</horizontal_fov>
          <image><width>640</width><height>400</height><format>L8</format></image>
          <clip><near>0.10</near><far>30.0</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.003</stddev></noise>
        </camera>
      </sensor>
      <sensor name="ov9281_stereo_right" type="camera">
        <pose>0 -0.06 0 0 0 0</pose>
        <topic>/uav/stereo/right/image</topic>
        <gz_frame_id>uav_stereo_right_optical_frame</gz_frame_id>
        <always_on>false</always_on><update_rate>20</update_rate><visualize>false</visualize>
        <camera>
          <horizontal_fov>1.57079632679</horizontal_fov>
          <image><width>640</width><height>400</height><format>L8</format></image>
          <clip><near>0.10</near><far>30.0</far></clip>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.003</stddev></noise>
        </camera>
      </sensor>
      <sensor name="stereo_depth" type="rgbd_camera">
        <topic>/uav/stereo/depth</topic>
        <gz_frame_id>uav_stereo_depth_optical_frame</gz_frame_id>
        <always_on>true</always_on><update_rate>10</update_rate><visualize>false</visualize>
        <camera>
          <horizontal_fov>1.57079632679</horizontal_fov>
          <image><width>320</width><height>200</height><format>R8G8B8</format></image>
          <clip><near>0.10</near><far>30.0</far></clip>
          <depth_camera><output>depths</output></depth_camera>
        </camera>
      </sensor>
    </link>
    <joint name="stereo_rig_mount" type="fixed">
      <parent>iris_with_standoffs::base_link</parent><child>stereo_rig_link</child>
    </joint>

    <!-- 16-layer 3D lidar. The horizontal scan is also available, while the
         /points stream is used by the 3D local obstacle fusion node. -->
    <link name="lidar_3d_link">
      <pose relative_to="iris_with_standoffs::base_link">0 0 0.10 0 0 0</pose>
      <gravity>false</gravity>
      <inertial>
        <mass>0.18</mass>
        <inertia><ixx>0.00030</ixx><iyy>0.00030</iyy><izz>0.00035</izz></inertia>
      </inertial>
      <visual name="body">
        <geometry><cylinder><radius>0.045</radius><length>0.055</length></cylinder></geometry>
        <material><ambient>0.03 0.03 0.03 1</ambient><diffuse>0.07 0.07 0.08 1</diffuse></material>
      </visual>
      <sensor name="lidar_3d" type="gpu_lidar">
        <topic>/uav/lidar3d</topic>
        <gz_frame_id>uav_lidar_3d_frame</gz_frame_id>
        <always_on>true</always_on><update_rate>4</update_rate><visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>192</samples><resolution>1</resolution>
              <min_angle>-3.14159265359</min_angle><max_angle>3.14159265359</max_angle>
            </horizontal>
            <vertical>
              <samples>16</samples><resolution>1</resolution>
              <min_angle>-1.57079632679</min_angle><max_angle>1.57079632679</max_angle>
            </vertical>
          </scan>
          <range><min>0.25</min><max>35.0</max><resolution>0.02</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.02</stddev></noise>
        </lidar>
      </sensor>
    </link>
    <joint name="lidar_3d_mount" type="fixed">
      <parent>iris_with_standoffs::base_link</parent><child>lidar_3d_link</child>
    </joint>

